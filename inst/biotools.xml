          <term>NetCDF</term>
        </format>
      </input>
      <output>
        <data>
          <uri>http://edamontology.org/data_2536</uri>
          <term>Mass spectrometry data</term>
        </data>
      </output>
      <note>Read mass spectrometry raw data Open netCDF, mzXML or mzML files using a format-specific backend. Access spectra, chromatograms, and run and instrument metadata through mzR objects.</note>
    </function>
    <function>
      <operation>
        <uri>http://edamontology.org/operation_1812</uri>
