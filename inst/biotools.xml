          <uri>http://edamontology.org/data_2536</uri>
          <term>Mass spectrometry data</term>
        </data>
      </output>
      <note>Read peptide identification data Open mzIdentML 1.1 files using the ProteoWizard backend to access peptide-spectrum matches, scores and identification metadata.</note>
    </function>
    <function>
